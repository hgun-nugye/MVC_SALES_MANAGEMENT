@model List<QuanLyBanHang.Models.DonMuaHangDetail>

@{
    ViewBag.Title = "Xóa Đơn mua hàng";
    var header = Model.FirstOrDefault();
}

<style>
    .page-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-body {
        padding: 2.5rem;
    }

    .item-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }

    .item-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .warning-box {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1rem;
        align-items: start;
    }

    .action-bar {
        background: #f8f9fa;
        padding: 1.5rem 2.5rem;
        border-top: 1px solid #e9ecef;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    .table-detail th {
        background-color: #f8f9fa;
        font-weight: 700;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="page-header">
                <div>
                    <h4 class="mb-0 fw-bold">Xác nhận xóa Đơn mua hàng</h4>
                    <small class="opacity-75">Hành động này không thể hoàn tác</small>
                </div>
                <i class="fa-solid fa-trash-can fa-2x opacity-50"></i>
            </div>

            @if (header != null)
            {
                <div class="info-card">
                    <div class="card-body">
                        <div class="warning-box">
                            <i class="fa-solid fa-triangle-exclamation fa-2x text-warning"></i>
                            <div>
                                <h5 class="fw-bold mb-1">Cảnh báo</h5>
                                <p class="mb-0">Bạn đang thực hiện xóa <strong>Đơn mua hàng #@header.MaDMH</strong>. Việc này sẽ xóa toàn bộ chi tiết sản phẩm thuộc đơn này và cập nhật lại tồn kho sản phẩm.</p>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-sm-6 col-md-4">
                                <div class="item-label">Mã đơn mua hàng</div>
                                <div class="item-value">#@header.MaDMH</div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="item-label">Ngày mua hàng</div>
                                <div class="item-value">@header.NgayMH.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="item-label">Trạng thái</div>
                                <div class="item-value">
                                    <span class="badge bg-secondary">@header.TenTTMH</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="item-label">Nhà cung cấp</div>
                                <div class="item-value text-primary">@header.TenNCC</div>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3"><i class="fa-solid fa-list me-2"></i>Chi tiết sản phẩm:</h5>
                        <div class="table-responsive">
                            <table class="table table-hover table-detail border">
                                <thead>
                                    <tr>
                                        <th class="text-center">STT</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 1;
                                        decimal tongTien = 0;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        var thanhTien = (item.SLM ?? 0) * (item.DGM ?? 0);
                                        tongTien += thanhTien;
                                        <tr>
                                            <td class="text-center">@stt</td>
                                            <td>@item.TenSP</td>
                                            <td class="text-center">@item.SLM</td>
                                            <td class="text-end">@string.Format("{0:N0} đ", item.DGM)</td>
                                            <td class="text-end fw-bold">@string.Format("{0:N0} đ", thanhTien)</td>
                                        </tr>
                                        stt++;
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="4" class="text-end">Tổng cộng:</th>
                                        <th class="text-end text-danger fs-5">@string.Format("{0:N0} đ", tongTien)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="action-bar">
                        <form id="deleteForm" asp-action="Delete" asp-controller="DonMuaHang" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@header.MaDMH" />
                            
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4" style="border-radius: 8px;">
                                <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
                            </a>
                            <button type="button" class="btn btn-danger fw-bold px-4" style="border-radius: 8px;" onclick="confirmDelete()">
                                <i class="fa-solid fa-trash-can me-2"></i> Xác nhận xóa đơn hàng
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: 'Bạn có chắc chắn muốn xóa đơn mua hàng này? Hành động này không thể hoàn tác!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy bỏ',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
